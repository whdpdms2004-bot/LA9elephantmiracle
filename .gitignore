# ── 대회 원본 데이터 (합계 약 690MB) ──────────────────────────
data/train.csv
data/trackman_history.csv
# 형식 확인용 5행 샘플(data/test.csv, data/sample_submission.csv)은 커밋한다.

# ── 제출 산출물 ────────────────────────────────────────────
# ZIP과 가중치는 제외하고 기록 문서(.md)와 빌드 코드(.py)는 남긴다.
cowork/*/submit/**
!cowork/*/submit/**/
!cowork/*/submit/**/*.md
!cowork/*/submit/**/*.py
submit/**
!submit/**/
!submit/**/*.md
!submit/**/*.py

# ── 임시 / 폐기 예정 폴더 ──────────────────────────────────
**/_tmp_export/
**/_to_delete/
**/smoke_outputs/
**/seed_cache/
output/

# ── 모델 가중치 · 바이너리 아티팩트 ─────────────────────────
*.zip
*.pt
*.pth
*.pkl
*.joblib
*.onnx
*.ubj
*.cbm
*.npy
*.npz
*.db
*.bin
*.safetensors
lgb_*.txt
*.tmp

# ── 대용량 데이터 파일 ─────────────────────────────────────
*.parquet
*.feather
cowork/**/*.csv
*.pdf

# 팀 결합(Phase E)용 공통 Val2024 예측만 예외.
# 253,507행 x 2컬럼 = 약 2.5MB. 상관 행렬과 결합 가중치 산출에 필요하다.
# 규격은 cowork/sj/claude/16_ENSEMBLE_HANDOFF.md 참고.
!cowork/*/val2024_pred.csv

# hw v8 production 가중치 예외 (33MB).
# 정희원이 "cowork/hw/submission_v8/ 그대로 커밋해서 올려주세요"라고 직접 요청했고
# 본인 노트북(12코어 CPU)으로는 4시간+ 걸려 sj가 대신 실행한 산출물이다.
# 네이티브 포맷(.cbm/.txt)이라 pickle 금지 규칙은 지킨다.
# 일반 원칙(가중치 대신 학습 코드)의 예외이며 다른 폴더로 확대하지 않는다.
!cowork/hw/submission_v8/model/*.cbm
!cowork/hw/submission_v8/model/lgb_*.txt

# ── 로그 ──────────────────────────────────────────────────
*.log

# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/
*.egg-info/

# ── Node ──────────────────────────────────────────────────
node_modules/

# ── 에디터 / OS ───────────────────────────────────────────
.vscode/
.idea/
.DS_Store
